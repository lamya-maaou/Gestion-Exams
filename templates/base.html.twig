<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Gestion des Exams{% endblock %}</title>
    
     <!-- Lien vers ton fichier CSS -->
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

    <!-- Lien vers Bootstrap pour un design rapide -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css">

    {% block stylesheets %}
    {% endblock %}
</head>

<body>

    <!-- Navbar (barre de navigation) -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container-fluid">
            <a class="navbar-brand" href="{{ path('home') }}">GExams</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="{{ path('app_etudiant_index') }}">Etudiants</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_enseignant_index') }}">Enseignants</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_filiere_index') }}">Filieres</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_semestre_index') }}">Semestre</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_module_index') }}">Module</a>
                    </li>
                    
                </ul>
            </div>
        </div>
    </nav>

    <!-- Contenu principal de la page -->
    <div class="container mt-4">
        {% block body %}{% endblock %}
    </div>

    <!-- Footer -->
    <footer class="bg-light text-center py-3 mt-4">
        <p>&copy; 2024 GExams. Tous droits réservés.</p>
    </footer>

    <!-- Intégrer les scripts JS (Bootstrap ou autres) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js" integrity="sha384-pzjw8f+ua7Kw1TIq0p4mSvf5J3yozmjvbbp3iyJg6qjxZpZdLwW9axE0D+dQik1s" crossorigin="anonymous"></script>

    {% block javascripts %}
    {% endblock %}

</body>

</html>
